# MongoDB Atlas Cloud Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=itsm_helpdesk

# ServiceNow Integration (mock or real)
SERVICENOW_MODE=mock
SERVICENOW_URL=https://dev00000.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_password_here

# Open-Source AI Models (Hugging Face & Sentence Transformers)
HF_MODEL_NAME=google/flan-t5-base
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Threshold Settings
RAG_SIMILARITY_THRESHOLD=0.35
AI_CONFIDENCE_THRESHOLD=0.65
